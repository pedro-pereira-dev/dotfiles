#!/bin/bash
set -euo pipefail

printf '\n'
{{ template "shared/add_logging" . -}}

{{ if eq .chezmoi.os "darwin" -}}
if _log_check 'Checking for macOS updates' "$HOME/.local/bin/mysoftwareupdate" --check; then
  _log_start 'Updating' 'macOS'
  "$HOME/.local/bin/mysoftwareupdate"
  _log_ok
fi

if [[ -x "$HOME/.local/bin/mybrew" ]]; then
  if _log_check 'Checking homebrew' "$HOME/.local/bin/mybrew" check; then
    _log_start 'Maintaining' 'homebrew'
    "$HOME/.local/bin/mybrew"
    _log_ok
  fi
fi
{{ end -}}
