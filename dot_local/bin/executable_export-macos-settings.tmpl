#!/bin/bash
set -euo pipefail

if [[ $(uname -s) != Darwin ]]; then
  printf 'This script must run on macOS.\n' >&2
  exit 1
fi

source_dir={{ joinPath .chezmoi.homeDir .sourceDirectory | quote }}
output="$source_dir/.chezmoitemplates/install-tools/darwin/overwrite-settings"
temporary=$(mktemp)
trap 'rm -f "$temporary"' EXIT

if [[ ! -d $source_dir/.chezmoitemplates ]]; then
  printf 'Chezmoi source directory does not exist: %s\n' "$source_dir" >&2
  exit 1
fi

: >"$temporary"

export_domains() {
  local scope=$1 domain data

  while IFS= read -r domain; do
    domain=${domain#"${domain%%[![:space:]]*}"}
    domain=${domain%"${domain##*[![:space:]]}"}
    [[ -n $domain ]] || continue

    if [[ $scope == defaults ]]; then
      data=$(defaults export "$domain" - 2>/dev/null | /usr/bin/base64 | tr -d '\n') || continue
      printf "printf '%%s' %q | /usr/bin/base64 -D | defaults import %q -\n" "$data" "$domain" >>"$temporary"
    else
      data=$(defaults -currentHost export "$domain" - 2>/dev/null | /usr/bin/base64 | tr -d '\n') || continue
      printf "printf '%%s' %q | /usr/bin/base64 -D | defaults -currentHost import %q -\n" "$data" "$domain" >>"$temporary"
    fi
  done < <(
    if [[ $scope == defaults ]]; then
      defaults domains
    else
      defaults -currentHost domains
    fi | tr ',' '\n' | LC_ALL=C sort
  )
}

export_domains defaults
export_domains current-host
mv "$temporary" "$output"
trap - EXIT

printf 'Exported all readable macOS defaults to:\n%s\n' "$output"
printf 'Review the file for private and machine-specific data before committing it.\n'
