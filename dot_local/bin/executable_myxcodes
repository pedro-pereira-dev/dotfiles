#!/bin/bash
set -euo pipefail

_releases=$(xcodes update)
_latest=${_releases##*$'\n'}

[[ ${1:-} != --check ]] || { [[ $_releases == *'(Installed)'* && $_latest != *'(Installed)'* ]]; exit; }
[[ $_releases == *'(Installed)'* && $_latest != *'(Installed)'* ]] || exit 0
[[ ${1:-} == --force ]] || read -r -p "Install $_latest? [Y/n] " _answer
[[ ${1:-} == --force || -z ${_answer:-} || $_answer == [Yy] ]] || exit 0

xcodes install "$_latest"
