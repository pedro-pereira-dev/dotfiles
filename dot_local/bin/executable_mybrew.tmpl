#!/bin/bash
set -euo pipefail

_check() {
  brew update &>/dev/null || return

  [[ -n $(brew outdated --quiet) ]] ||
    ! brew bundle check --file="$HOME/.Brewfile" &>/dev/null ||
    [[ -n $(brew bundle cleanup --dry-run --file="$HOME/.Brewfile" 2>/dev/null) ]] ||
    [[ -n $(brew cleanup --dry-run 2>/dev/null) ]]
}

_update() {
  brew update
  brew bundle install --upgrade --file="$HOME/.Brewfile"
  brew bundle cleanup --file="$HOME/.Brewfile"
  brew cleanup
}

_list() {
  _formulae=$(brew list --formula --installed-on-request -1)
  _casks=$(brew list --cask -1)
  _green_bold=$'\033[1;32m'
  _reset=$'\033[0m'

  printf '\n'
  printf '%sFormulae%s\n' "$_green_bold" "$_reset"
  printf '%s--------%s\n' "$_green_bold" "$_reset"
  printf '%s\n' "$_formulae"

  printf '\n'
  printf '%sCasks%s\n' "$_green_bold" "$_reset"
  printf '%s-----%s\n' "$_green_bold" "$_reset"
  printf '%s\n' "$_casks"
  printf '\n'
}

case ${1:-} in
check) _check ;;
update) _update ;;
*) _list ;;
esac
