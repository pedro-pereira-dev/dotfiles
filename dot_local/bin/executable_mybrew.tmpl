#!/bin/bash
set -euo pipefail

_update() {
  [[ ${1:-} != update ]] || shift

  brew update
  brew bundle install --upgrade --file="$HOME/.Brewfile"
  brew bundle cleanup "$@" --file="$HOME/.Brewfile"
  brew cleanup
}

_list() {
  printf 'Formulae\n'
  printf '%s\n' '--------'
  brew list --formula --installed-on-request -1

  printf '\nCasks\n'
  printf '%s\n' '-----'
  brew list --cask -1
}

case ${1:-} in
list) _list ;;
*) _update "$@" ;;
esac
