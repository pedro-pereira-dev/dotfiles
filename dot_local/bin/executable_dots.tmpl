#!/bin/bash
set -euo pipefail

_direct_chezmoi="$(command -v chezmoi || true)"
_mise_chezmoi="$(mise which chezmoi 2>/dev/null || true)"
_install_chezmoi() { bash -c "$(curl -fsSL get.chezmoi.io)" -- -b /tmp "$@"; }

_chezmoi=(_install_chezmoi)
[[ -z $_mise_chezmoi ]] ||
  _chezmoi=(mise exec chezmoi -- chezmoi)
[[ -z $_direct_chezmoi ]] ||
  _chezmoi=(chezmoi)

_github_user=${DOTS_GITHUB_USER:-{{ .githubUser | quote }}}
_directory=${DOTS_SOURCE_DIRECTORY:-{{ joinPath .chezmoi.homeDir .sourceDirectory | quote }}}
mkdir -p "$_directory"

case ${1:-} in
bootstrap) "${_chezmoi[@]}" init --apply --source "$_directory" "$_github_user" ;;
update) "${_chezmoi[@]}" update --source "$_directory" ;;
esac
