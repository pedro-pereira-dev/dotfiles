#!/bin/bash
set -euo pipefail

if [[ $(uname -s) != Darwin ]]; then
  printf 'This script must run on macOS.\n' >&2
  exit 1
fi

output=/tmp/macos-settings.txt

domains=(
  NSGlobalDomain
  com.apple.Accessibility
  com.apple.AppleMultitouchMouse
  com.apple.AppleMultitouchTrackpad
  com.apple.Bluetooth
  com.apple.HIToolbox
  com.apple.LaunchServices
  com.apple.SoftwareUpdate
  com.apple.WindowManager
  com.apple.controlcenter
  com.apple.driver.AppleBluetoothMultitouch.mouse
  com.apple.driver.AppleBluetoothMultitouch.trackpad
  com.apple.dock
  com.apple.finder
  com.apple.loginwindow
  com.apple.menuextra.clock
  com.apple.preference.sound
  com.apple.screencapture
  com.apple.screensaver
  com.apple.spaces
  com.apple.symbolichotkeys
  com.apple.universalaccess
)

read_domains() {
  local scope=$1 domain data

  for domain in "${domains[@]}"; do
    if [[ $scope == current-host ]]; then
      data=$(defaults -currentHost read "$domain" 2>/dev/null) || continue
    else
      data=$(defaults read "$domain" 2>/dev/null) || continue
    fi

    printf '===== %s: %s =====\n%s\n\n' "$scope" "$domain" "$data"
  done
}

{
  read_domains defaults
  read_domains current-host
} >"$output"

printf 'Exported readable macOS defaults to:\n%s\n' "$output"
