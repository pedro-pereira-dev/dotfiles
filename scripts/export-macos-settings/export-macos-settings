#!/bin/bash
set -euo pipefail

if [[ $(uname -s) != Darwin ]]; then
  printf 'This script must run on macOS.\n' >&2
  exit 1
fi

output=/tmp/macos-settings.txt

{
  printf '%s\n' '===== defaults ====='
  defaults read
  printf '\n%s\n' '===== current host defaults ====='
  defaults -currentHost read
} >"$output"

printf 'Exported readable macOS defaults to:\n%s\n' "$output"
