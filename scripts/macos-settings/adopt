#!/usr/bin/env python3
"""Interactively adopt snapshot differences into desired state."""

import argparse
import json
import sys

sys.dont_write_bytecode = True

from macos_settings import (
    FILTERS,
    MISSING,
    atomic_text,
    change_kind,
    filtered_changes,
    identity,
    load_desired,
    load_filters,
    load_snapshot,
    render_change,
    resolve_snapshots,
    supported_value,
    write_desired,
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--all", action="store_true", help="include normally filtered settings")
    parser.add_argument("snapshots", nargs="*", metavar="SNAPSHOT")
    arguments = parser.parse_args()
    try:
        old_path, new_path = resolve_snapshots(arguments.snapshots)
        old, new = load_snapshot(old_path), load_snapshot(new_path)
        filters = load_filters()
        differences = filtered_changes(old, new, None if arguments.all else filters)
        desired = load_desired()
    except ValueError as error:
        parser.error(str(error))

    records = {identity(record): record for record in desired}
    changed_desired = False
    changed_filters = False
    print(f"Comparing {old_path.name} -> {new_path.name}")
    for change in differences:
        print("\n" + render_change(change))
        while True:
            choice = input("[a] adopt latest  [d] track deletion  [r] remove desired  [s] skip  [f] filter: ").strip().lower()
            key = identity(change)
            if choice == "a":
                if change["new"] is not MISSING and not supported_value(change["new"]):
                    print("Cannot adopt: defaults supports only bool, int, float, string, and scalar arrays.")
                    continue
                records[key] = _record(change, change["new"])
                changed_desired = True
                break
            if choice == "d":
                records[key] = _record(change, MISSING)
                changed_desired = True
                break
            if choice == "r":
                changed_desired = records.pop(key, None) is not None or changed_desired
                break
            if choice == "s":
                break
            if choice == "f":
                exact = dict(zip(("scope", "domain", "key"), key))
                if exact not in filters["settings"]:
                    filters["settings"].append(exact)
                    changed_filters = True
                break
            print("Choose a, d, r, s, or f.")

    if changed_desired:
        write_desired(records.values())
        print("Updated desired state.")
    if changed_filters:
        filters["settings"].sort(key=lambda item: (item["scope"], item["domain"], item["key"]))
        atomic_text(FILTERS, json.dumps(filters, indent=2, sort_keys=True) + "\n")
        print("Updated filters.")
    if not differences:
        print("No differences.")
    return 0


def _record(change, value):
    record = {name: change[name] for name in ("scope", "domain", "key")}
    if value is MISSING:
        record["delete"] = True
    else:
        record["value"] = value
    return record


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (EOFError, KeyboardInterrupt):
        print("\nadopt: cancelled; no changes written", file=sys.stderr)
        raise SystemExit(130)
    except (OSError, ValueError) as error:
        print(f"adopt: {error}", file=sys.stderr)
        raise SystemExit(2)
