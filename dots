#!/usr/bin/env bash
# shellcheck disable=SC1090
set -euo pipefail

export DOTFILES_BRANCH=${DOTFILES_BRANCH:-main}
export DOTFILES_URL=${DOTFILES_URL:-https://github.com/pedro-pereira-dev/dotfiles}
export DOTFILES_WORKSPACE="$HOME/workspace/personal/dotfiles"

for _util in "$DOTFILES_WORKSPACE"/utils/*.sh; do source "$_util"; done
[[ -f $DOTFILES_WORKSPACE/hosts/$(hostname -s).sh ]] ||
  { printf "No configuration found for host '%s'" "$(hostname -s)" && exit 1; }
source "$DOTFILES_WORKSPACE/hosts/$(hostname -s).sh"

case ${1-} in
pull) dots_pull ;;
sync) dots_sync ;;
update) dots_pull && "$DOTFILES_WORKSPACE/dots" sync ;;
*) printf 'Usage: dots [pull|sync|update]\n' >&2 && exit 1 ;;
esac
