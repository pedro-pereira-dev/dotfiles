#!/usr/bin/env bash
# shellcheck disable=SC1090
set -euo pipefail

export DOTFILES_BRANCH=${DOTFILES_BRANCH:-main}
export DOTFILES_URL=${DOTFILES_URL:-https://github.com/pedro-pereira-dev/dotfiles}
export DOTFILES_WORKSPACE="$HOME/workspace/personal/dotfiles"

for _util in "$DOTFILES_WORKSPACE"/utils/*.sh; do source "$_util"; done
dots_update() { dots_pull "$@" && dots_sync "$@"; }

[[ -f $DOTFILES_WORKSPACE/hosts/$(hostname)/$(hostname).sh ]] ||
  { log_fail 'No configuration found for host' "$(hostname)" && exit 1; }
source "$DOTFILES_WORKSPACE/hosts/$(hostname)/$(hostname).sh"

case ${1-} in
pull) dots_pull "${@:2}" ;;
sync) dots_sync "${@:2}" ;;
update) dots_update "${@:2}" ;;
*) log_fail 'Usage: dots' '{pull|sync|update}' && exit 1 ;;
esac
