#!/usr/bin/env bash
set -euo pipefail

export DOTFILES_BRANCH=${DOTFILES_BRANCH:-main}
export DOTFILES_URL=${DOTFILES_URL:-https://github.com/pedro-pereira-dev/dotfiles}
export DOTFILES_WORKSPACE="$HOME/workspace/personal/dotfiles"

for _lib in "$DOTFILES_WORKSPACE"/lib/*.sh; do source "$_lib"; done

_host=$(hostname -s)
_host_config="$DOTFILES_WORKSPACE/hosts/$_host.sh"
if [[ ! -f $_host_config ]]; then
  printf "No configuration found for host '%s'\n" "$_host" >&2
  exit 1
fi

source "$_host_config"

case ${1-} in
pull) dots_pull ;;
sync) dots_sync ;;
update) dots_pull && "$DOTFILES_WORKSPACE/dots" sync ;;
*) printf 'Usage: dots [pull|sync|update]\n' >&2 && exit 1 ;;
esac
