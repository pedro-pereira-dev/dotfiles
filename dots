#!/usr/bin/env bash
#
# attempts to run script from the same execution directory - for /tmp executions
# if scripts do not exist, tries running from the workspace directory - for already cloned dotfiles executions
# if no workspace directory exists, sets up the latest tarball on /tmp
# then load libraries and other sources and execute the commands
set -euo pipefail

_main() {
  export DOTFILES_BRANCH=${DOTFILES_BRANCH:-main}
  export DOTFILES_URL=${DOTFILES_URL:-https://github.com/pedro-pereira-dev/dotfiles}
  export DOTFILES_WORKSPACE="$HOME/workspace/personal/dotfiles"

  local root _script
  root=$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd) ||
    root=""

  if [[ ! -d $root/dots.d && -x $DOTFILES_WORKSPACE/dots && -d $DOTFILES_WORKSPACE/dots.d ]]; then
    exec "$DOTFILES_WORKSPACE/dots" "$@"
  fi

  if [[ ! -d $root/dots.d ]]; then
    rm -fr /tmp/dotfiles
    mkdir -p /tmp/dotfiles
    printf 'Downloading the latest dotfiles tarball...\n'
    curl -fsSL "$DOTFILES_URL/archive/refs/heads/$DOTFILES_BRANCH.tar.gz" |
      tar -xz --strip-components=1 -C /tmp/dotfiles
    exec /tmp/dotfiles/dots "$@"
  fi

  export DOTS_ROOT="$root"
  local _command=${1-}
  shift || true

  for _script in \
    "$DOTS_ROOT"/dots.d/*.sh \
    "$DOTS_ROOT"/dots.d/lib/*.sh; do
    source "$_script"
  done

  if ! declare -F "dots_$_command" >/dev/null; then
    printf 'Usage: dots <bootstrap|setup|pull|update> [OPTIONS]\n' >&2
    return 2
  fi

  "dots_$_command" "$@"
}

_main "$@"
