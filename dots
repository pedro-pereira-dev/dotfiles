#!/usr/bin/env bash
set -euo pipefail

export DOTFILES_BRANCH=${DOTFILES_BRANCH:-main}
export DOTFILES_URL=${DOTFILES_URL:-https://github.com/pedro-pereira-dev/dotfiles}
export DOTFILES_WORKSPACE="$HOME/workspace/personal/dotfiles"

DOTS_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export DOTS_ROOT

_command=${1-}
shift || true

for _lib in "$DOTS_ROOT"/lib/*.sh; do source "$_lib"; done
if [[ -f $DOTS_ROOT/dots.d/dots_$_command.sh ]]; then
  source "$DOTS_ROOT/dots.d/dots_$_command.sh"
  "dots_$_command" "$@"
  exit
fi

case $_command in
pull) dots_pull ;;
update) dots_pull && exec "$DOTS_ROOT/dots" setup "$@" ;;
esac
