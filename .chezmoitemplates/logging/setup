_log_bold=$'\033[1m'
_log_cyan_bold=$'\033[1;36m'
_log_green_bold=$'\033[1;32m'
_log_orange=$'\033[33m'

_log_divider='----------------------------------------'
_log_reset=$'\033[0m'

_log_start() {
  _log_action=$1
  _log_subject=$2
  _log_message="${_log_action} ${_log_subject}"
  _log_started_at=$SECONDS

  printf \
    '\n\n- %s%s%s %s\n%s%s%s\n\n' \
    "$_log_cyan_bold" "$_log_action" "$_log_reset" \
    "$_log_subject" \
    "$_log_bold" "$_log_divider" "$_log_reset"
}

_log_ok() {
  _log_elapsed=$((SECONDS - _log_started_at))
  if (( _log_elapsed >= 60 )); then
    _log_duration="$((_log_elapsed / 60))m $((_log_elapsed % 60))s"
  else
    _log_duration="${_log_elapsed}s"
  fi

  printf \
    -- '\n- "%s%s%s %s" (%sexecuted in%s %s%s%s) %sOK%s\n\n' \
    "$_log_cyan_bold" "$_log_action" "$_log_reset" \
    "$_log_subject" \
    "$_log_orange" "$_log_reset" \
    "$_log_bold" "$_log_duration" "$_log_reset" \
    "$_log_green_bold" "$_log_reset"
}
