{{ $host := index .hosts .chezmoi.hostname | default dict -}}
{{ $installChezmoi := dig "installChezmoi" false $host -}}
{{ $useBash := dig "useBash" false $host -}}
{{ $installHomebrew := or (dig "installHomebrew" false $host) (hasKey $host "homebrew") -}}
{{ $installXcode := dig "installXcode" false $host -}}

{{ if $installChezmoi -}}
{{ template "install-tools/darwin/install-chezmoi" . -}}
{{ else if $installHomebrew -}}
{{ template "install-tools/darwin/install-homebrew" . -}}
{{ else if $installXcode -}}
{{ template "install-tools/darwin/install-xcode" . -}}
{{ end -}}

{{ if $useBash -}}
{{ template "install-tools/darwin/setup-bash" . -}}
{{ end -}}

{{ if hasKey $host "homebrew" -}}
HOMEBREW_NO_ASK=1 \
  "$HOME/.local/bin/mybrew" --force
{{ end -}}
