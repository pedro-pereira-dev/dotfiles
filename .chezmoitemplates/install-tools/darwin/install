{{ $host := index .hosts .chezmoi.hostname | default dict -}}
{{ $useBash := dig "useBash" false $host -}}
{{ $installHomebrew := dig "installHomebrew" false $host -}}
{{ $installXcode := dig "installXcode" false $host -}}
{{ $manageHomebrew := or $useBash (hasKey $host "homebrew") -}}

{{ if or $installHomebrew $manageHomebrew -}}
{{ template "install-tools/darwin/install-homebrew" . -}}
{{ else if $installXcode -}}
{{ template "install-tools/darwin/install-xcode" . -}}
{{ end -}}

{{ if $manageHomebrew -}}
{{ template "install-tools/darwin/maintain-homebrew" . -}}
{{ end -}}

{{ if $useBash -}}
{{ template "install-tools/darwin/setup-bash" . -}}
{{ end -}}
