{{ template "install-tools/darwin/install-xcode" . -}}

if [[ ! -x /opt/homebrew/bin/brew ]]; then
  _log_start 'Installing' 'homebrew'
  NONINTERACTIVE={{ if eq .chezmoi.command "init" }}1{{ end }} \
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  _log_ok
fi

# configure homebrew when either path is missing
if [[ ":$PATH:" != *':/opt/homebrew/bin:'* ||
  ":$PATH:" != *':/opt/homebrew/sbin:'* ]]; then
  _log_start 'Configuring' 'homebrew'
  [[ ":$PATH:" != *':/opt/homebrew/sbin:'* ]] && export PATH="/opt/homebrew/sbin:$PATH"
  [[ ":$PATH:" != *':/opt/homebrew/bin:'* ]] && export PATH="/opt/homebrew/bin:$PATH"
  _log_ok
fi
