{{ template "install-tools/darwin/install-homebrew" . -}}

if ! brew list --formula bash >/dev/null 2>&1; then
  _log_start 'installing bash'
  brew install -y bash
  _log_ok
fi

# adds up to date bash version
if ! grep -qxF /opt/homebrew/bin/bash /etc/shells; then
  _log_start 'adding bash to allowed shells'
  printf '/opt/homebrew/bin/bash\n' | sudo tee -a /etc/shells >/dev/null
  _log_ok
fi

# changes user shell
if ! dscl . -read "/Users/$USER" UserShell | grep -qxF 'UserShell: /opt/homebrew/bin/bash'; then
  _log_start 'changing the default shell to bash'
  sudo chsh -s /opt/homebrew/bin/bash "$USER"
  _log_ok
fi
