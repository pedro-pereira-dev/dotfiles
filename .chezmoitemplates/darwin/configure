{{ $host := index .hosts .chezmoi.hostname | default dict -}}
{{ $useBash := dig "useBash" false $host -}}
{{ $installHomebrew := dig "installHomebrew" false $host -}}
{{ $installXcode := dig "installXcode" false $host -}}
{{ $manageHomebrew := or $useBash (hasKey $host "homebrew") -}}

if _log_check 'Checking for macOS updates' "$HOME/.local/bin/mysoftwareupdate" --check; then
  _log_start 'Updating' 'macOS'
  "$HOME/.local/bin/mysoftwareupdate"
  _log_ok
fi

{{ if or $installHomebrew $manageHomebrew -}}
{{ template "darwin/install_homebrew" . -}}
{{ else if $installXcode -}}
{{ template "darwin/install_xcode" . -}}
{{ end -}}

{{ if $manageHomebrew -}}
{{ template "darwin/maintain_homebrew" . -}}
{{ end -}}

{{ if $useBash -}}
{{ template "darwin/configure_bash" . -}}
{{ end -}}
