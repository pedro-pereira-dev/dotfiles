#!/usr/bin/env bash
set -euo pipefail

_check=0 _force=0
for _arg; do
  case $_arg in
  --check) _check=1 ;;
  --force) _force=1 ;;
  esac
done

_updates=$(softwareupdate --list 2>&1)
[[ $_updates == *'No new software available'* ]] && exit
((_check)) && exit 1

if ! ((_force)); then
  read -rp 'Install available macOS updates? [Y/n] ' _answer
  [[ -z $_answer || $_answer == [yY]* ]] || exit 0
fi

softwareupdate --install --all --no-scan
