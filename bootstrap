#!/usr/bin/env bash
# shellcheck disable=SC1090,SC1091
set -euo pipefail

DOTFILES_DEFAULT_BRANCH=${DOTFILES_DEFAULT_BRANCH:-main}
DOTFILES_REPOSITORY_URL=${DOTFILES_REPOSITORY_URL:-https://github.com/pedro-pereira-dev/dotfiles}
DOTFILES_WORKSPACE=${DOTFILES_WORKSPACE:-$HOME/workspace/personal/dotfiles}

DOTFILES_ARCHIVE_URL=${DOTFILES_ARCHIVE_URL:-${DOTFILES_REPOSITORY_URL%.git}/archive/refs/heads/$DOTFILES_DEFAULT_BRANCH.tar.gz}
_TMP_WORKSPACE=/tmp/dotfiles

_prepare_temp_workspace() {
  rm -fr "$_TMP_WORKSPACE"
  mkdir -p "$_TMP_WORKSPACE"
  printf 'Downloading the latest dotfiles tarball...\n'
  if ! curl -fsSL "$DOTFILES_ARCHIVE_URL" |
    tar -xz --strip-components=1 -C "$_TMP_WORKSPACE"; then
    rm -fr "$_TMP_WORKSPACE"
    return 1
  fi
}

_bootstrap() {
  local _workspace=$DOTFILES_WORKSPACE
  local -x NONINTERACTIVE=1
  if [[ ! -f $_workspace/dots ]]; then
    _prepare_temp_workspace || return
    _workspace=$_TMP_WORKSPACE
  fi
  source "$_workspace/dots" update --verbose "$@"
}

[[ ${BASH_SOURCE[0]-$0} != "$0" ]] || _bootstrap "$@"
